{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  }
}
